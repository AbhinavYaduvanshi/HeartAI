# ==============================================================================
# HeartAI — Environment Configuration Template
# Copy this file to .env and fill in your actual values.
# DO NOT commit real secrets or production credentials to version control.
# ==============================================================================

# Application Environment (development | staging | production)
APP_ENV=development
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000
# Cryptographic Secrets (REQUIRED: Generate a secure 32+ character key)
# Command: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=replace_with_a_secure_random_secret_key_minimum_32_characters
# SECRET_KEY_FALLBACK=previous_secret_key_for_dual_key_rotation
# TELEMETRY_HMAC_KEY=replace_with_dedicated_hmac_pepper_or_leave_empty_for_derived
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL / SQLite fallback)
DATABASE_URL=sqlite:///./heartai.db
# For PostgreSQL:
# DATABASE_URL=postgresql://heartai_user:your_secure_password@localhost:5432/heartai_db

# CORS Allowed Origins (JSON array or comma-separated strings)
CORS_ORIGINS=["http://localhost:8000","http://localhost:8080","http://127.0.0.1:8000","http://127.0.0.1:8080"]

# Rate Limiting
RATE_LIMIT_DEFAULT=60/minute

# Model Governance & Operating Threshold
MODEL_PATH=models/best_model.joblib
PREPROCESSOR_PATH=models/preprocessing_pipeline.joblib
METADATA_PATH=models/model_metadata.json
OPERATING_THRESHOLD=0.09

# Google Gemini AI Integration (Generative Clinical Analytics)
# Obtain from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Frontend / UI Configuration
NICEGUI_STORAGE_SECRET=replace_with_nicegui_storage_secret

# Logging Level (DEBUG | INFO | WARNING | ERROR | CRITICAL)
LOG_LEVEL=INFO
LOG_FILE_PATH=logs/heartai.log
