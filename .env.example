# ==============================================================================
# HeartAI — Environment Configuration Template
# Copy this file to .env and fill in your actual values.
# DO NOT commit real secrets or production credentials to version control.
# ==============================================================================

# Application Environment (development | staging | production)
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
APP_SECRET_KEY=replace_with_a_secure_random_secret_key_minimum_32_characters

# Database Configuration (PostgreSQL / SQLite fallback)
DATABASE_URL=sqlite:///./heartai.db
# For PostgreSQL:
# DATABASE_URL=postgresql://heartai_user:your_password@localhost:5432/heartai_db

# Google Gemini AI Integration (Generative Clinical Analytics)
# Obtain from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Frontend / UI Configuration
NICEGUI_STORAGE_SECRET=replace_with_nicegui_storage_secret

# Logging Level (DEBUG | INFO | WARNING | ERROR | CRITICAL)
LOG_LEVEL=INFO
LOG_FILE_PATH=logs/heartai.log

