# ==============================================================================
# HeartAI Production Environment Configuration Template
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to /opt/heartai/.env
# 2. Restrict permissions: chmod 600 /opt/heartai/.env && chown heartai:heartai /opt/heartai/.env
# 3. Generate high-entropy secrets using: python -c 'import secrets; print(secrets.token_urlsafe(32))'
# 4. Fill in PostgreSQL and Redis credentials
# 5. NEVER commit real credentials to version control!
# ==============================================================================

# Core Application Runtime
APP_ENV=production
APP_DEBUG=false
APP_HOST=127.0.0.1
APP_PORT=8000
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=8080
BACKEND_API_URL=https://your-domain.org

# Cryptographic Secrets (MANDATORY: Minimum 32 characters, high entropy)
SECRET_KEY=REPLACE_WITH_GENERATED_32_CHAR_SECRET_KEY
SECRET_KEY_FALLBACK=
TELEMETRY_HMAC_KEY=REPLACE_WITH_GENERATED_32_CHAR_HMAC_KEY
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL 16)
DATABASE_URL=postgresql://heartai_user:REPLACE_WITH_DB_PASSWORD@localhost:5432/heartai_db

# Cache & Distributed Rate Limiting (Redis 7+)
REDIS_URL=redis://127.0.0.1:6379/0

# Strict CORS Origins (Wildcard '*' is strictly prohibited in production)
CORS_ORIGINS=["https://your-domain.org","https://www.your-domain.org"]

# Rate Limiting Thresholds
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_AI_CHAT=20/minute
RATE_LIMIT_AI_SYMPTOMS=15/minute
RATE_LIMIT_AI_PERSONALIZED=10/minute

# ML Model Artifacts & Screening Threshold
MODEL_PATH=models/best_model.joblib
PREPROCESSOR_PATH=models/preprocessing_pipeline.joblib
METADATA_PATH=models/model_metadata.json
OPERATING_THRESHOLD=0.09
CURRENT_CONSENT_TERMS_VERSION=2026.1

# Optional Generative AI (Google Gemini - Leave empty for offline educational mode)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_SECONDS=15.0
GEMINI_MAX_OUTPUT_TOKENS=1024
GEMINI_TEMPERATURE=0.2

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE_PATH=/var/log/heartai/heartai.log
